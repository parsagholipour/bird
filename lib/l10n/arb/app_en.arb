  "chapter_1_route": "The Canopy Route",
  "@chapter_1_route": {
    "description": "The name of campaign chapter 1, a mail route (its boss: Baron Bat). On the map's chapter ribbon (in capitals there), the postcard's signature (\"— The Canopy Route\") and screen-reader labels. A route name, like the name of a railway line; glossary \"chapter\".",
    "x-maxChars": 26
  },
  "chapter_1_postmark": "CANOPY ROUTE",
  "@chapter_1_postmark": {
    "description": "Chapter 1's route name as the round postmark on its postcard prints it, curved along the upper rim: capitals, without a leading article where your language can drop it. The same route as \"The Canopy Route\". It shrinks to fit the ring; short is better.",
    "x-maxChars": 20
  },
  "chapter_1_postcard": "Letters are landing in the treetops again! The toucans say thank you (very loudly). Baron Bat’s crown is on our mantelpiece.",
  "@chapter_1_postcard": {
    "description": "The message on chapter 1's postcard, which arrives after Baron Bat is beaten, written by the friends along the route to the courier (the player's bird). It follows the greeting \"Dear courier,\" on its own line, so it starts as a new sentence. Warm, funny, short: it must fit about seven short lines of the card (keep within 150 characters)."
  },
  "chapter_1_postscript": "The ancient road smells like something is bubbling.",
  "@chapter_1_postscript": {
    "description": "The postscript on chapter 1's postcard, after the label \"P.S.\": a hint about where the next route has gone wrong. One or two short lines (keep within 64 characters).",
    "x-maxChars": 64
  },
  "chapter_2_route": "The Ancient Road",
